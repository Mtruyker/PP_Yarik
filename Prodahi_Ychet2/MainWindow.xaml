<Window x:Class="Prodahi_Ychet2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prodahi_Ychet2"
        mc:Ignorable="d"
        Title="Учет компьютерной техники" Language="ru-RU" Height="650" Width="1100" MinHeight="650" MinWidth="1000">

    <Window.DataContext>
        <local:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- ТАБЛИЦА ТОВАРОВ (Цены отображаются в формате: Число руб.) -->
        <DataGrid Grid.Column="0" ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,10,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="2*"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="1*"/>
                <DataGridTextColumn Header="Остаток" Binding="{Binding Stock}" Width="0.8*"/>
                <DataGridTextColumn Header="Закупка" Binding="{Binding PurchasePrice, StringFormat='{}{0:N2} руб.'}" Width="1*"/>
                <DataGridTextColumn Header="Продажа" Binding="{Binding SellingPrice, StringFormat='{}{0:N2} руб.'}" Width="1*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ПАНЕЛЬ УПРАВЛЕНИЯ (СПРАВА) -->
        <StackPanel Grid.Column="1">

            <!-- Блок закупки -->
            <TextBlock Text="ПОСТУПЛЕНИЕ (ЗАКУПКА)" FontWeight="Bold" Margin="0,0,0,5" Foreground="#2C3E50"/>

            <TextBlock Text="Название:"/>
            <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,5"/>

            <TextBlock Text="Категория:"/>
            <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding NewCategory}" Margin="0,0,0,5"/>

            <TextBlock Text="Количество:"/>
            <TextBox Text="{Binding NewStock, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,5"/>

            <TextBlock Text="Цена закупки (руб.):"/>
            <TextBox Text="{Binding NewPurchasePrice, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,5"/>

            <TextBlock Text="Цена продажи (руб.):"/>
            <TextBox Text="{Binding NewSellingPrice, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,5"/>

            <Button Content="Принять на склад" Command="{Binding AddProductCommand}" Height="25" Margin="0,0,0,20" Background="#27AE60" Foreground="White" FontWeight="Bold"/>

            <!-- Блок продажи -->
            <TextBlock Text="ПРОДАЖА ТОВАРА" FontWeight="Bold" Margin="0,0,0,5" Foreground="#2C3E50"/>

            <TextBlock Text="Выбранный товар:"/>
            <TextBox Text="{Binding SelectedProduct.Name, Mode=OneWay}" IsReadOnly="True" Background="#EFEFEF" Margin="0,0,0,5" FontWeight="Bold"/>

            <TextBlock Text="Количество к продаже:"/>
            <TextBox Text="{Binding SaleQuantity, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

            <Button Content="Оформить продажу" Command="{Binding SellProductCommand}" Height="30" Background="#2980B9" Foreground="White" FontWeight="Bold"/>
            <Button Content="Обновить каталог" Command="{Binding RefreshCommand}" Height="28" Margin="0,12,0,5"/>
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#2C3E50"/>

        </StackPanel>
    </Grid>
</Window>
